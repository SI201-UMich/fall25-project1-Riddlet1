def load_file():
    data_list = []
    with open("C:\\Users\\thefo\\OneDrive\\Documents\\SI 201\\fall25-project1-Riddlet1\\crop_yield.csv", "r") as file:
        data = csv.DictReader(file)
        for row in data:
            data_list.append(row)

#    print(data_list)
    return data_list

def get_soils():
    soil_list = []
    for sample in load_file():
        if sample["Soil_Type"] not in soil_list:
            soil_list.append(sample["Soil_Type"])
#    print(soil_list)
    return soil_list

def get_regions():
    region_list = []
