import csv

def load_file():
    data_list = []
    with open("C:\\Users\\thefo\\OneDrive\\Documents\\SI 201\\fall25-project1-Riddlet1\\crop_yield.csv", "r") as file:
        data = csv.DictReader(file)
        for row in data:
            data_list.append(row)

#    print(data_list)
    return data_list


def get_crops():
    crop_list = []
    for sample in load_file():
        if sample["Crop"] not in crop_list:
            crop_list.append(sample["Crop"])       
#    print(crop_list)
    return crop_list

    
def compare_harvest(region, soil):
    totals = {}
    for crop in get_crops():
#        print(crop)
        yields = []
        for sample in load_file(): 
            if sample["Region"] == region and sample["Soil_Type"] == soil:
                yields.append(float(sample["Yield_tons_per_hectare"]))
        totals[crop] = sum(yields) / len(yields)
        print(totals)
#    print(totals)
    return totals


def compare_fertilizer_use(rainfall_min, weather_condition):
    rainfall_list = []
    weather_list = []
    for sample in load_file():
#        print(float(sample["Rainfall_mm"]))
        if float(sample["Rainfall_mm"]) > rainfall_min:
#            print("higher")
            if sample["Fertilizer_Used"] == "True":
#                print("True")
                rainfall_list.append(100)
            if sample["Fertilizer_Used"] == "False":
                rainfall_list.append(0)
#        print(rainfall_list)
        if sample["Weather_Condition"] == weather_condition:
            if sample["Fertilizer_Used"] == "True":
                weather_list.append(100)
            if sample["Fertilizer_Used"] == "False":
                weather_list.append(0)
    if len(rainfall_list) > 0:
        rainfall_percent = round(sum(rainfall_list) / len(rainfall_list), 2)
    else:
        rainfall_percent = "None"
    if len(weather_list) > 0:
        weather_percent = round(sum(weather_list) / len(weather_list), 2)
    else:
        weather_percent = "None"
    print(f"Percentage of fertilizer used with over {rainfall_min}mm of rainfall: {rainfall_percent} \n Percentage of fertilizer used in {weather_condition} conditions: {weather_percent}")
    return f"Percentage of fertilizer used with over {rainfall_min}mm of rainfall: {rainfall_percent} \n Percentage of fertilizer used in {weather_condition} conditions: {weather_percent}"

    
    


